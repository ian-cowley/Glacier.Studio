<Project Sdk="Microsoft.NET.Sdk.Razor">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <OutputType>WinExe</OutputType>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <Version>1.1.0</Version>
    <ApplicationTitle>Glacier Agent Studio (Antigravity 2)</ApplicationTitle>
    <Authors>Ian Cowley</Authors>
    <Company>Glacier High-Performance Ecosystem</Company>
    <Description>Pure C# .NET 10 autonomous desktop AI agent IDE and runtime cockpit built on Photino WebView, Glacier.Clavier System-1 routing, Glacier.Graph AST indexing, Glacier.DocTree zero-copy markdown, and Glacier.Inference / Glacier.Inference.Distributed GPU cluster orchestration.</Description>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageProjectUrl>https://github.com/ian-cowley/Glacier.Studio</PackageProjectUrl>
    <RepositoryUrl>https://github.com/ian-cowley/Glacier.Studio.git</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Photino.Blazor" Version="4.0.13" />
    <PackageReference Include="Microsoft.Extensions.Http" Version="10.0.0" />
    <PackageReference Include="Glacier.Inference" Version="1.3.2" />
    <PackageReference Include="Glacier.Gpu" Version="1.1.0" />
    <PackageReference Include="Glacier.Polaris" Version="1.1.0" />
    <PackageReference Include="Glacier.Vector" Version="1.1.0" />
    <PackageReference Include="Glacier.Graph" Version="1.1.0" />
    <PackageReference Include="Glacier.DocTree" Version="1.2.0" />
    <PackageReference Include="Glacier.Clavier" Version="1.1.0" />
    <PackageReference Include="Glacier.AgentDevKit.Adk" Version="1.1.0" />
    <PackageReference Include="TinyPdf" Version="0.2.0" />
  </ItemGroup>

  <ItemGroup>
    <Content Update="wwwroot\**">
      <CopyToOutputDirectory>Always</CopyToOutputDirectory>
    </Content>
  </ItemGroup>

</Project>
