<Project Sdk="Microsoft.NET.Sdk.Razor">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <OutputType>WinExe</OutputType>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <Version>1.3.0</Version>
    <PackageReleaseNotes>v1.3.0: Migrate legacy Glacier.Showcase.Services.GlacierStudio namespace to Glacier.Studio.Services and replace bare catch blocks with filtered exception tracing.</PackageReleaseNotes>
    <ApplicationTitle>Glacier Agent Studio (Antigravity 2)</ApplicationTitle>
    <Authors>Ian Cowley</Authors>
    <Company>Glacier High-Performance Ecosystem</Company>
    <Description>Pure C# .NET 10 autonomous desktop AI agent IDE and runtime cockpit built on Photino WebView, Glacier.Clavier System-1 routing, Glacier.Graph AST indexing, Glacier.DocTree zero-copy markdown, and Glacier.Inference / Glacier.Cluster / Glacier.Serve GPU cluster orchestration.</Description>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageProjectUrl>https://github.com/ian-cowley/Glacier.Studio</PackageProjectUrl>
    <RepositoryUrl>https://github.com/ian-cowley/Glacier.Studio.git</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
  </PropertyGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Glacier.Studio.Tests" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Photino.Blazor" />
    <PackageReference Include="Microsoft.Extensions.Http" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="../../../Glacier.Inference/src/Glacier.Inference/Glacier.Inference.csproj" Condition="Exists('../../../Glacier.Inference/src/Glacier.Inference/Glacier.Inference.csproj') and '$(UseLocalProjectReferences)' != 'false'" />
    <PackageReference Include="Glacier.Inference" Condition="!Exists('../../../Glacier.Inference/src/Glacier.Inference/Glacier.Inference.csproj') or '$(UseLocalProjectReferences)' == 'false'" />

    <ProjectReference Include="../../../Glacier.Gpu/src/Glacier.Gpu/Glacier.Gpu.csproj" Condition="Exists('../../../Glacier.Gpu/src/Glacier.Gpu/Glacier.Gpu.csproj') and '$(UseLocalProjectReferences)' != 'false'" />
    <PackageReference Include="Glacier.Gpu" Condition="!Exists('../../../Glacier.Gpu/src/Glacier.Gpu/Glacier.Gpu.csproj') or '$(UseLocalProjectReferences)' == 'false'" />

    <ProjectReference Include="../../../Glacier.Polaris/src/Glacier.Polaris/Glacier.Polaris.csproj" Condition="Exists('../../../Glacier.Polaris/src/Glacier.Polaris/Glacier.Polaris.csproj') and '$(UseLocalProjectReferences)' != 'false'" />
    <PackageReference Include="Glacier.Polaris" Condition="!Exists('../../../Glacier.Polaris/src/Glacier.Polaris/Glacier.Polaris.csproj') or '$(UseLocalProjectReferences)' == 'false'" />

    <ProjectReference Include="../../../Glacier.Vector/src/Glacier.Vector/Glacier.Vector.csproj" Condition="Exists('../../../Glacier.Vector/src/Glacier.Vector/Glacier.Vector.csproj') and '$(UseLocalProjectReferences)' != 'false'" />
    <PackageReference Include="Glacier.Vector" Condition="!Exists('../../../Glacier.Vector/src/Glacier.Vector/Glacier.Vector.csproj') or '$(UseLocalProjectReferences)' == 'false'" />

    <ProjectReference Include="../../../Glacier.Graph/src/Glacier.Graph/Glacier.Graph.csproj" Condition="Exists('../../../Glacier.Graph/src/Glacier.Graph/Glacier.Graph.csproj') and '$(UseLocalProjectReferences)' != 'false'" />
    <PackageReference Include="Glacier.Graph" Condition="!Exists('../../../Glacier.Graph/src/Glacier.Graph/Glacier.Graph.csproj') or '$(UseLocalProjectReferences)' == 'false'" />

    <ProjectReference Include="../../../Glacier.DocTree/src/Glacier.DocTree/Glacier.DocTree.csproj" Condition="Exists('../../../Glacier.DocTree/src/Glacier.DocTree/Glacier.DocTree.csproj') and '$(UseLocalProjectReferences)' != 'false'" />
    <PackageReference Include="Glacier.DocTree" Condition="!Exists('../../../Glacier.DocTree/src/Glacier.DocTree/Glacier.DocTree.csproj') or '$(UseLocalProjectReferences)' == 'false'" />

    <ProjectReference Include="../../../Glacier.Clavier/src/Glacier.Clavier/Glacier.Clavier.csproj" Condition="Exists('../../../Glacier.Clavier/src/Glacier.Clavier/Glacier.Clavier.csproj') and '$(UseLocalProjectReferences)' != 'false'" />
    <PackageReference Include="Glacier.Clavier" Condition="!Exists('../../../Glacier.Clavier/src/Glacier.Clavier/Glacier.Clavier.csproj') or '$(UseLocalProjectReferences)' == 'false'" />

    <ProjectReference Include="../../../Glacier.Rag/src/Glacier.Rag/Glacier.Rag.csproj" Condition="Exists('../../../Glacier.Rag/src/Glacier.Rag/Glacier.Rag.csproj') and '$(UseLocalProjectReferences)' != 'false'" />
    <PackageReference Include="Glacier.Rag" Condition="!Exists('../../../Glacier.Rag/src/Glacier.Rag/Glacier.Rag.csproj') or '$(UseLocalProjectReferences)' == 'false'" />

    <ProjectReference Include="../../../Glacier.Cluster/src/Glacier.Cluster/Glacier.Cluster.csproj" Condition="Exists('../../../Glacier.Cluster/src/Glacier.Cluster/Glacier.Cluster.csproj') and '$(UseLocalProjectReferences)' != 'false'" />
    <PackageReference Include="Glacier.Cluster" Condition="!Exists('../../../Glacier.Cluster/src/Glacier.Cluster/Glacier.Cluster.csproj') or '$(UseLocalProjectReferences)' == 'false'" />

    <ProjectReference Include="../../../Glacier.Serve/src/Glacier.Serve/Glacier.Serve.csproj" Condition="Exists('../../../Glacier.Serve/src/Glacier.Serve/Glacier.Serve.csproj') and '$(UseLocalProjectReferences)' != 'false'" />
    <PackageReference Include="Glacier.Serve" Condition="!Exists('../../../Glacier.Serve/src/Glacier.Serve/Glacier.Serve.csproj') or '$(UseLocalProjectReferences)' == 'false'" />
  </ItemGroup>

  <ItemGroup>
    <Content Update="wwwroot\**">
      <CopyToOutputDirectory>Always</CopyToOutputDirectory>
    </Content>
  </ItemGroup>

</Project>
