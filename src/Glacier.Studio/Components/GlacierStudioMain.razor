    private async Task HandleKeyDown(KeyboardEventArgs e)
    {
        if (_isSlashMenuOpen && _filteredSlashCommands.Count > 0)
        {
            if (e.Key == "ArrowDown")
            {
                _selectedSlashIndex = (_selectedSlashIndex + 1) % _filteredSlashCommands.Count;
                StateHasChanged();
                return;
            }
            if (e.Key == "ArrowUp")
            {
                _selectedSlashIndex = (_selectedSlashIndex - 1 + _filteredSlashCommands.Count) % _filteredSlashCommands.Count;
                StateHasChanged();
                return;
            }
            if (e.Key == "Enter" || e.Key == "Tab")
            {
                SelectSlashCommand(_filteredSlashCommands[_selectedSlashIndex]);
                return;
            }
            if (e.Key == "Escape")
            {
                _isSlashMenuOpen = false;
                StateHasChanged();
                return;
            }
        }

        if (e.Key == "Enter" && !e.ShiftKey)
        {
            await SendMessageAsync();
        }
    }

    private void RefreshSlashCommands()
    {
        var list = new List<SlashOption>
        {
            new("btw", "Ask a quick question without interrupting the main conversation", "btw", "General"),
            new("team", "Run autonomous heterogeneous agent team across Host + Beast", "team", "Cluster"),
            new("goal", "Run until the specified goal is completely finished", "goal", "Agent"),
            new("plan", "Plan carefully before executing a task", "plan", "Agent"),
            new("compact", "Compact the conversation now (summarize history to free up context)", "compact", "Context"),
            new("terminal", "Directly run a shell command in the interactive terminal", "terminal", "Tools"),
            new("inspect", "Inspect and preview any workspace file with Glacier.DocTree AST", "inspect", "Tools"),
            new("graph", "Query the Glacier.Graph Knowledge Graph ontology", "graph", "Knowledge"),
            new("browser", "Invoke a web inspection & research agent for online tasks", "browser", "Web"),
            new("schedule", "Run an instruction on a recurring schedule or as a one-time timer", "schedule", "Automation"),
            new("grill-me", "Interview me through an interactive session to align on a plan", "btw", "Agent"),
            new("mcp", "List all connected MCP servers and available tools", "mcp", "MCP"),
            new("settings", "Configure model servers, endpoints, API keys, and MCP tools", "settings", "Settings"),
            new("runtimes", "Open Local Inference Runtimes & Hardware telemetry panel", "runtimes", "Telemetry"),
            new("clear", "Clear conversation history and session working memory", "clear", "Session")
        };

        foreach (var server in McpManager.Servers)
        {
            foreach (var tool in server.AvailableTools)
            {
                list.Add(new SlashOption(
                    $"mcp:{server.Name}:{tool}",
                    $"Execute '{tool}' via {server.Name} MCP server",
