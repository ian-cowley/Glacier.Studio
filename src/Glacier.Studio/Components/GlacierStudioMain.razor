    }

    private bool _isSlashMenuOpen = false;
    private int _selectedSlashIndex = 0;
    private string _slashQuery = "";
    private List<SlashOption> _allSlashCommands = new();
    private List<SlashOption> _filteredSlashCommands = new();
    private static readonly Regex SlashQueryRegex = new Regex(@"(?:^|\s)/([a-zA-Z0-9_\-:]*)$", RegexOptions.Compiled);

    private string UserConsoleCommand { get; set; } = "";
    private string GraphQueryInput { get; set; } = "Workspace";
    private string ExportNotification { get; set; } = "";
    private bool IsDocFormattedView { get; set; } = true;
    private bool IsDocOutlineVisible { get; set; } = true;
    private bool IsRightPanelVisible { get; set; } = true;
    private bool IsSettingsModalOpen { get; set; } = false;
    private string ActiveSettingsTab { get; set; } = "models";
    private string ConnectionTestResult { get; set; } = "";
    private bool IsTestingConnection { get; set; } = false;
    private int SelectedOutlineLine { get; set; } = 1;
    private HashSet<string> _expandedThinkingMessages = new();
    private IReadOnlyList<DeviceInfo> _cachedDevices = Array.Empty<DeviceInfo>();
    private DeviceInfo? _cachedOptimalDevice;
    private double _cachedTotalRamGb;
    private System.Timers.Timer? _liveTurnTimer;

    protected override void OnInitialized()
    {
        StudioState.OnStateChanged += HandleStateChanged;
        ConsoleService.OnLogAdded += HandleStateChanged;
        DocPreviewService.OnDocumentChanged += HandleStateChanged;
        RuntimeLauncher.OnRuntimeStateChanged += HandleStateChanged;

        RefreshSlashCommands();

        _liveTurnTimer = new System.Timers.Timer(100);
        _liveTurnTimer.Elapsed += (_, _) =>
        {
            if (StudioState.IsExecutingTurn)
            {
                InvokeAsync(StateHasChanged);
            }
        };
        _liveTurnTimer.Start();

        RefreshHardwareTelemetry();
        _ = RuntimeLauncher.ProbeAllRuntimesAsync();
    }

    private string GetActiveTurnElapsedText()
    {
        if (StudioState.ActiveTurnStartUtc is { } startUtc)
        {
            double elapsed = Math.Max(0.0, (DateTime.UtcNow - startUtc).TotalSeconds);
            return $"⏱ {elapsed:F1}s";
        }
        return "⏱ 0.0s";
    }

    private string GetHealthDotClass(RuntimeHealthState state) => state switch
    {
        RuntimeHealthState.Online => "online",
        RuntimeHealthState.Starting => "starting",
        RuntimeHealthState.MissingProject => "missing",
        _ => "offline"
    };

    private string GetActiveProviderDotClass()
    {
        if (StudioState.Provider == ModelServerProvider.LocalGlacierInference)
        {
            return GetHealthDotClass(RuntimeLauncher.InferenceState);
        }
        if (StudioState.Provider == ModelServerProvider.LocalGlacierDistributed)
        {
            return GetHealthDotClass(RuntimeLauncher.DistributedState);
        }
        if (StudioState.Provider == ModelServerProvider.ClusterBeastCoder)
        {
            return GetHealthDotClass(RuntimeLauncher.BeastClusterState);
        }
        return "online";
    }

    private void RefreshHardwareTelemetry()
