                    server.Name
                ));
            }
        }

        _allSlashCommands = list;
    }

    private void UpdateSlashCommandState()
    {
        if (string.IsNullOrEmpty(_currentInput))
        {
            _isSlashMenuOpen = false;
            return;
        }

        var match = SlashQueryRegex.Match(_currentInput);
        if (match.Success)
        {
            _slashQuery = match.Groups[1].Value;
            _filteredSlashCommands = _allSlashCommands
                .Where(c => c.Command.Contains(_slashQuery, StringComparison.OrdinalIgnoreCase) ||
                            c.Description.Contains(_slashQuery, StringComparison.OrdinalIgnoreCase) ||
                            c.Category.Contains(_slashQuery, StringComparison.OrdinalIgnoreCase))
                .OrderBy(c => c.Command.StartsWith(_slashQuery, StringComparison.OrdinalIgnoreCase) ? 0 : 1)
                .ThenBy(c => c.Command)
                .ToList();

            _selectedSlashIndex = Math.Clamp(_selectedSlashIndex, 0, Math.Max(0, _filteredSlashCommands.Count - 1));
            _isSlashMenuOpen = _filteredSlashCommands.Count > 0;
        }
        else
        {
            _isSlashMenuOpen = false;
        }
    }

    private void SelectSlashCommand(SlashOption cmd)
    {
        var match = SlashQueryRegex.Match(_currentInput);
        if (match.Success)
        {
            int slashPos = match.Index + (match.Value.StartsWith(" ") ? 1 : 0);
            _currentInput = _currentInput.Substring(0, slashPos) + "/" + cmd.Command + " ";
        }
        else
        {
            _currentInput = "/" + cmd.Command + " ";
        }
        _isSlashMenuOpen = false;
        StateHasChanged();
    }

