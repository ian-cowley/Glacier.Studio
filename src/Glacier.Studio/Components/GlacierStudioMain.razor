</div>

@code {
    private string CurrentInput { get; set; } = "";
    private string UserConsoleCommand { get; set; } = "";
    private string GraphQueryInput { get; set; } = "Workspace";
    private string ExportNotification { get; set; } = "";
    private bool IsDocFormattedView { get; set; } = true;
    private bool IsDocOutlineVisible { get; set; } = true;
    private bool IsRightPanelVisible { get; set; } = true;
    private bool IsSettingsModalOpen { get; set; } = false;
    private string ActiveSettingsTab { get; set; } = "models";
    private string ConnectionTestResult { get; set; } = "";
    private bool IsTestingConnection { get; set; } = false;
    private int SelectedOutlineLine { get; set; } = 1;
    private HashSet<string> _expandedThinkingMessages = new();
    private IReadOnlyList<DeviceInfo> _cachedDevices = Array.Empty<DeviceInfo>();
    private DeviceInfo? _cachedOptimalDevice;
    private double _cachedTotalRamGb;
    private System.Timers.Timer? _liveTurnTimer;

    protected override void OnInitialized()
    {
        StudioState.OnStateChanged += HandleStateChanged;
        ConsoleService.OnLogAdded += HandleStateChanged;
        DocPreviewService.OnDocumentChanged += HandleStateChanged;
        RuntimeLauncher.OnRuntimeStateChanged += HandleStateChanged;

        _liveTurnTimer = new System.Timers.Timer(100);
        _liveTurnTimer.Elapsed += (_, _) =>
        {
            if (StudioState.IsExecutingTurn)
            {
                InvokeAsync(StateHasChanged);
            }
        };
        _liveTurnTimer.Start();

        RefreshHardwareTelemetry();
        _ = RuntimeLauncher.ProbeAllRuntimesAsync();
    }

    private string GetActiveTurnElapsedText()
    {
        if (StudioState.ActiveTurnStartUtc is { } startUtc)
        {
            double elapsed = Math.Max(0.0, (DateTime.UtcNow - startUtc).TotalSeconds);
            return $"⏱ {elapsed:F1}s";
        }
        return "⏱ 0.0s";
    }

    private string GetHealthDotClass(RuntimeHealthState state) => state switch
    {
        RuntimeHealthState.Online => "online",
        RuntimeHealthState.Starting => "starting",
        RuntimeHealthState.MissingProject => "missing",
        _ => "offline"
    };

    private string GetActiveProviderDotClass()
    {
        if (StudioState.Provider == ModelServerProvider.LocalGlacierInference)
        {
            return GetHealthDotClass(RuntimeLauncher.InferenceState);
        }
        if (StudioState.Provider == ModelServerProvider.LocalGlacierDistributed)
        {
            return GetHealthDotClass(RuntimeLauncher.DistributedState);
        }
        return "online";
    }

    private void RefreshHardwareTelemetry()
    {
        try
        {
            _cachedDevices = DeviceManager.GetDevices();
            _cachedOptimalDevice = DeviceManager.GetOptimalDevice();
            _cachedTotalRamGb = GC.GetGCMemoryInfo().TotalAvailableMemoryBytes / (1024.0 * 1024.0 * 1024.0);
        }
        catch (Exception ex)
        {
            ConsoleService.AddLog("SYSTEM", $"Hardware telemetry query warning: {ex.Message}", isError: true);
        }
    }

    private void HandleStateChanged()
    {
        InvokeAsync(StateHasChanged);
    }

    public void Dispose()
    {
        if (_liveTurnTimer != null)
        {
            _liveTurnTimer.Stop();
            _liveTurnTimer.Dispose();
            _liveTurnTimer = null;
        }
        StudioState.OnStateChanged -= HandleStateChanged;
        ConsoleService.OnLogAdded -= HandleStateChanged;
        DocPreviewService.OnDocumentChanged -= HandleStateChanged;
        RuntimeLauncher.OnRuntimeStateChanged -= HandleStateChanged;
    }

    private void CreateNewChat()
    {
        StudioState.CreateNewSession();
    }

    private void SelectSession(string id)
    {
        StudioState.SwitchSession(id);
    }

    private void DeleteSession(string id)
    {
        StudioState.DeleteSession(id);
    }

    private void OnProviderChanged(ChangeEventArgs e)
    {
        if (Enum.TryParse<ModelServerProvider>(e.Value?.ToString(), out var provider))
        {
            StudioState.SetProvider(provider);
        }
    }

    private void OnModelPresetSelected(ChangeEventArgs e)
    {
        string? preset = e.Value?.ToString();
        if (!string.IsNullOrWhiteSpace(preset))
        {
            StudioState.SelectedModel = preset;
            StudioState.ActiveSession.ModelSnapshot = StudioState.GetModelDisplayName();
            StudioState.SaveActiveSession();
            StudioState.NotifyStateChanged();
        }
    }

    private void ExportSession(string format)
    {
        try
        {
            string path = StudioState.ExportActiveSessionToDisk(format);
            ConsoleService.AddLog("SYSTEM", $"Exported active session to: {path}");
            ExportNotification = $"Session exported successfully to '{Path.GetFileName(path)}'";
        }
        catch (Exception ex)
        {
            ConsoleService.AddLog("SYSTEM", $"Export failed: {ex.Message}", isError: true);
            ExportNotification = $"Export failed: {ex.Message}";
        }
    }

    private string? _copiedMessageId;

    private sealed record DisplayTurn(string Role, List<ChatMessage> Messages);

    private List<DisplayTurn> GetGroupedDisplayTurns(IReadOnlyList<ChatMessage> messages)
    {
        var turns = new List<DisplayTurn>();
        List<ChatMessage>? currentAssistantGroup = null;

        for (int i = 0; i < messages.Count; i++)
        {
            var msg = messages[i];
            if (msg.Role == "tool") continue;

            if (msg.Role == "user")
            {
                // Skip internal Clavier supervision nudges so they don't split the assistant turn
                if (msg.Content != null && (
                    msg.Content.StartsWith("[CLAVIER STEP SUPERVISOR]", StringComparison.Ordinal) ||
                    string.Equals(msg.Content, "Proceed autonomously with your execution plan now.", StringComparison.Ordinal)))
                {
                    continue;
                }

                currentAssistantGroup = null;
                turns.Add(new DisplayTurn("user", new List<ChatMessage> { msg }));
            }
            else if (msg.Role == "assistant")
            {
                var (cleanContent, thoughtContent) = ExtractThinking(msg);
                bool hasAnyCardContent = !string.IsNullOrWhiteSpace(cleanContent)
                    || !string.IsNullOrWhiteSpace(thoughtContent)
                    || !string.IsNullOrWhiteSpace(msg.ExecutionPlan)
                    || msg.ToolCalls.Count > 0;

                bool isLastMessage = i == messages.Count - 1;
                if (!hasAnyCardContent && (!StudioState.IsExecutingTurn || !isLastMessage))
                {
                    continue;
                }

                if (currentAssistantGroup == null)
                {
                    currentAssistantGroup = new List<ChatMessage>();
                    turns.Add(new DisplayTurn("assistant", currentAssistantGroup));
                }

                currentAssistantGroup.Add(msg);
            }
        }

        if (StudioState.IsExecutingTurn && (turns.Count == 0 || turns[^1].Role != "assistant"))
        {
            turns.Add(new DisplayTurn("assistant", new List<ChatMessage> { new ChatMessage { Role = "assistant" } }));
        }

        return turns;
    }

    private async Task CopyUnifiedTurnAsync(List<ChatMessage> turnMessages, string turnId)
    {
        var sb = new System.Text.StringBuilder();

        foreach (var msg in turnMessages)
        {
            var (cleanContent, thoughtContent) = ExtractThinking(msg);

            if (!string.IsNullOrWhiteSpace(msg.ExecutionPlan))
            {
                sb.AppendLine(msg.ExecutionPlan.Trim());
                sb.AppendLine();
            }

            if (!string.IsNullOrWhiteSpace(thoughtContent))
            {
                sb.AppendLine("<think>");
                sb.AppendLine(thoughtContent.Trim());
                sb.AppendLine("</think>");
                sb.AppendLine();
            }

            if (msg.ToolCalls.Count > 0)
            {
                foreach (var tc in msg.ToolCalls)
                {
                    sb.AppendLine($"### 🛠️ Tool: `{tc.ToolName}` ({(tc.IsSuccess ? "✓ Success" : "✕ Failed")}, {tc.Duration.TotalMilliseconds:F0} ms)");
                    sb.AppendLine("```json");
                    sb.AppendLine(tc.ArgumentsJson);
                    sb.AppendLine("```");
                    if (!string.IsNullOrWhiteSpace(tc.ResultOutput))
                    {
                        sb.AppendLine("```text");
                        sb.AppendLine(tc.ResultOutput.Trim());
                        sb.AppendLine("```");
                    }
                    sb.AppendLine();
                }
            }

            if (!string.IsNullOrWhiteSpace(cleanContent))
            {
                sb.AppendLine(cleanContent.Trim());
                sb.AppendLine();
            }
        }

        await CopyEntireResponseAsync(sb.ToString().Trim(), turnId);
    }

    private async Task CopyLatestTurnAsync(string copyId)
    {
        var messages = StudioState.ActiveSession.Messages;
        int lastUserIdx = -1;
        for (int i = messages.Count - 1; i >= 0; i--)
        {
            if (messages[i].Role == "user" && !messages[i].Content.StartsWith("[CLAVIER STEP SUPERVISOR]", StringComparison.Ordinal))
            {
                lastUserIdx = i;
                break;
            }
        }

        var sb = new System.Text.StringBuilder();
        int startIdx = lastUserIdx >= 0 ? lastUserIdx : 0;
        for (int i = startIdx; i < messages.Count; i++)
        {
            var m = messages[i];
            if (m.Role == "tool") continue;
            if (m.Role == "user")
            {
                if (m.Content.StartsWith("[CLAVIER STEP SUPERVISOR]", StringComparison.Ordinal)) continue;
                sb.AppendLine($"## 👤 User");
                sb.AppendLine(m.Content.Trim());
                sb.AppendLine();
                continue;
            }

            var (clean, thought) = ExtractThinking(m);
            if (string.IsNullOrWhiteSpace(clean) && string.IsNullOrWhiteSpace(thought) && string.IsNullOrWhiteSpace(m.ExecutionPlan) && m.ToolCalls.Count == 0)
                continue;

            if (!string.IsNullOrWhiteSpace(m.ExecutionPlan))
            {
                sb.AppendLine(m.ExecutionPlan.Trim());
                sb.AppendLine();
            }

            foreach (var tc in m.ToolCalls)
            {
                sb.AppendLine($"### 🛠️ `{tc.ToolName}` ({(tc.IsSuccess ? "✓ Success" : "✕ Failed")}, {tc.Duration.TotalMilliseconds:F0} ms)");
                sb.AppendLine("```json");
                sb.AppendLine(tc.ArgumentsJson);
                sb.AppendLine("```");
                if (!string.IsNullOrWhiteSpace(tc.ResultOutput))
                {
                    sb.AppendLine("```text");
                    sb.AppendLine(tc.ResultOutput.Trim());
                    sb.AppendLine("```");
                }
                sb.AppendLine();
            }

            if (!string.IsNullOrWhiteSpace(clean))
            {
                sb.AppendLine(clean.Trim());
                sb.AppendLine();
            }
        }

        await CopyEntireResponseAsync(sb.ToString().Trim(), copyId);
    }

    private async Task CopyEntireResponseAsync(string text, string msgId)
    {
        if (string.IsNullOrEmpty(text)) return;
        try
        {
            await JS.InvokeVoidAsync("navigator.clipboard.writeText", text);
        }
        catch
        {
            try
            {
                // Fallback for WebView2 environments where navigator.clipboard requires focus
                string escaped = System.Text.Json.JsonSerializer.Serialize(text);
                await JS.InvokeVoidAsync("eval", $"(function(){{const ta=document.createElement('textarea');ta.value={escaped};document.body.appendChild(ta);ta.select();document.execCommand('copy');document.body.removeChild(ta);}})()");
            }
            catch (Exception ex)
            {
                ConsoleService.AddLog("SYSTEM", $"Clipboard copy failed: {ex.Message}", isError: true);
                return;
            }
        }

        _copiedMessageId = msgId;
        StateHasChanged();
        _ = Task.Run(async () =>
        {
            await Task.Delay(2000);
            if (_copiedMessageId == msgId)
            {
                _copiedMessageId = null;
                await InvokeAsync(StateHasChanged);
            }
        });
    }

    private void SetInput(string val)
    {
        CurrentInput = val;
    }

    private void OpenRightDrawerTab(string tabName)
    {
        if (IsRightPanelVisible && StudioState.ActiveRightTab == tabName)
        {
            // Keep visible and focused on the requested tab
            StudioState.NotifyStateChanged();
            return;
        }
        IsRightPanelVisible = true;
        StudioState.ActiveRightTab = tabName;
        StudioState.NotifyStateChanged();
    }

    private async Task ExecuteQuickActionAsync(string slashCommand)
    {
        await AgentEngine.ProcessUserMessageAsync(slashCommand);
        StudioState.SaveActiveSession();
    }

    private async Task HandleKeyDown(KeyboardEventArgs e)
    {
        if (e.Key == "Enter" && !e.ShiftKey)
        {
            await SendMessageAsync();
        }
    }

    private void OpenSettingsModal(string tab = "models")
    {
        ActiveSettingsTab = tab;
        IsSettingsModalOpen = true;
        ConnectionTestResult = "";
    }

    private void CloseSettingsModal()
    {
        IsSettingsModalOpen = false;
    }

    private void ReloadMcpServers()
    {
        McpManager.DiscoverConfiguredServers();
        StateHasChanged();
    }

    private async Task TestEndpointConnectionAsync()
    {
        IsTestingConnection = true;
        ConnectionTestResult = "";
        StateHasChanged();
        try
        {
            var sw = Stopwatch.StartNew();
            using var cts = new CancellationTokenSource(TimeSpan.FromSeconds(4));
            using var client = HttpClientFactory.CreateClient();

            string url = StudioState.EndpointUrl?.Trim() ?? "";
            if (string.IsNullOrEmpty(url))
            {
                ConnectionTestResult = "⚠️ Endpoint URL is empty";
                return;
            }

            if (StudioState.Provider == ModelServerProvider.LocalOllama || StudioState.Provider == ModelServerProvider.LocalGlacierInference)
            {
                string pingUrl = url.Replace("/v1", "").TrimEnd('/') + "/api/tags";
                var resp = await client.GetAsync(pingUrl, cts.Token);
                sw.Stop();
                if (resp.IsSuccessStatusCode)
                {
                    ConnectionTestResult = $"✓ Success: Connected to engine in {sw.ElapsedMilliseconds} ms ({resp.StatusCode})";
                }
                else
                {
                    ConnectionTestResult = $"⚠️ Server responded with {resp.StatusCode} in {sw.ElapsedMilliseconds} ms";
                }
            }
            else
            {
                var req = new HttpRequestMessage(HttpMethod.Get, url.TrimEnd('/') + "/models");
                if (!string.IsNullOrEmpty(StudioState.ApiKey))
                {
                    req.Headers.Authorization = new AuthenticationHeaderValue("Bearer", StudioState.ApiKey);
                }
                var resp = await client.SendAsync(req, cts.Token);
                sw.Stop();
                ConnectionTestResult = $"✓ Response from server in {sw.ElapsedMilliseconds} ms (Status: {resp.StatusCode})";
            }
        }
        catch (Exception ex)
        {
            ConnectionTestResult = $"✕ Connection Failed: {ex.Message}";
        }
        finally
        {
            IsTestingConnection = false;
            StateHasChanged();
        }
    }

    private async Task SendMessageAsync()
    {
        if (string.IsNullOrWhiteSpace(CurrentInput)) return;

        string prompt = CurrentInput.Trim();
        CurrentInput = "";

        if (prompt.Equals("/settings", StringComparison.OrdinalIgnoreCase))
        {
            OpenSettingsModal("models");
            return;
        }

        await AgentEngine.ProcessUserMessageAsync(prompt);
        StudioState.SaveActiveSession();
    }

    private void CancelExecution()
    {
        AgentEngine.CancelCurrentExecution();
    }

    private (string CleanContent, string ThoughtContent) ExtractThinking(ChatMessage msg)
    {
        string thought = msg.ThinkingContent ?? "";
        string content = msg.Content ?? "";

        // Check if content itself contains <think> ... </think> tags
        if (content.Contains("<think>", StringComparison.OrdinalIgnoreCase))
        {
            int start = content.IndexOf("<think>", StringComparison.OrdinalIgnoreCase);
            int end = content.IndexOf("</think>", StringComparison.OrdinalIgnoreCase);

            if (end > start)
            {
                string tagThought = content.Substring(start + 7, end - (start + 7)).Trim();
                if (string.IsNullOrEmpty(thought))
                {
                    thought = tagThought;
                }
                content = (content.Substring(0, start) + content.Substring(end + 8)).Trim();
            }
            else if (StudioState.ExecutionStatus == AgentExecutionStatus.Thinking)
            {
                // Unclosed think tag during live generation
                string partialThought = content.Substring(start + 7).Trim();
                if (string.IsNullOrEmpty(thought))
                {
                    thought = partialThought;
                }
                content = content.Substring(0, start).Trim();
            }
        }

        return (content, thought);
    }

    private void ToggleThinking(ChatMessage msg)
    {
        if (_expandedThinkingMessages.Contains(msg.Id))
            _expandedThinkingMessages.Remove(msg.Id);
        else
            _expandedThinkingMessages.Add(msg.Id);
    }

    private bool IsThinkingExpanded(ChatMessage msg)
    {
        // Open by default if currently thinking this turn
        if (StudioState.ExecutionStatus == AgentExecutionStatus.Thinking &&
            msg == StudioState.ActiveSession.Messages.LastOrDefault())
        {
            return true;
        }

        return _expandedThinkingMessages.Contains(msg.Id);
    }

    private void OnWorkspaceFilePicked(ChangeEventArgs e)
    {
        string? picked = e.Value?.ToString();
        if (!string.IsNullOrWhiteSpace(picked))
        {
            DocPreviewService.LoadFile(picked);
        }
    }

    private async Task NavigateToHeading(int lineNumber)
    {
        SelectedOutlineLine = lineNumber;
        try
        {
            await JS.InvokeVoidAsync("eval", $"document.getElementById('heading-line-{lineNumber}')?.scrollIntoView({{ behavior: 'smooth', block: 'start' }})");
        }
        catch { }
    }

    private async Task HandleConsoleKeyDown(KeyboardEventArgs e)
    {
        if (e.Key == "Enter")
        {
            await ExecuteUserConsoleCommand();
        }
    }

    private async Task ExecuteUserConsoleCommand()
    {
        if (string.IsNullOrWhiteSpace(UserConsoleCommand)) return;
        string cmd = UserConsoleCommand;
        UserConsoleCommand = "";
        await ConsoleService.ExecuteCommandAsync(cmd, "USER");
    }

    private async Task RunQuickCommand(string cmd)
    {
        await ConsoleService.ExecuteCommandAsync(cmd, "USER");
    }

    private void ClearConsole()
    {
        ConsoleService.ClearLogs();
    }
